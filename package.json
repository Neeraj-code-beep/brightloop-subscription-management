{
  "name": "subscription-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Subscription Management System for Brightloop Software",
  "workspaces": [
    "frontend",
    "backend",
    "ai-service"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:worker": "npm --workspace=backend run worker",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:ai": "npm --workspace=ai-service run dev",
    "test:backend": "npm --workspace=backend run test",
    "test:frontend": "npm --workspace=frontend run test",
    "test:ai": "npm --workspace=ai-service run test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "author": "Brightloop Software Team",
  "license": "UNLICENSED"
}


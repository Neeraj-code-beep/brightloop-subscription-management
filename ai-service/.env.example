# AI Service Port
PORT=5001
NODE_ENV=development

# Google Gemini API Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.0-flash"

# Backend API Endpoint (for MCP tools calling internal backend)
BACKEND_API_URL="http://localhost:5000/api/v1"

# Vector Database (Neon PostgreSQL with pgvector for RAG)
DATABASE_URL="postgresql://user:password@ep-sample-neon-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"


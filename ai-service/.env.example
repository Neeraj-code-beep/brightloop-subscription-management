# AI Service Port
PORT=5001
NODE_ENV=development

# Google Gemini API Configuration (Primary LLM)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Hugging Face Configuration (Fallback LLM)
HUGGINGFACE_API_KEY="your-huggingface-api-key-here"
HUGGINGFACE_MODEL="meta-llama/Llama-3.1-8B-Instruct"
HUGGINGFACE_BASE_URL="https://router.huggingface.co/v1/chat/completions"

# Backend API Endpoint (for MCP tools calling internal backend)
BACKEND_API_URL="http://localhost:5000/api/v1"

# Isolated Knowledge Base Service (Optional - Independent from core business DB)
# Note: AI Service strictly does NOT connect directly to Neeraj's PostgreSQL database.
KNOWLEDGE_BASE_URL=""

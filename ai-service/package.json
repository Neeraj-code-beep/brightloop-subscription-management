{
  "name": "ai-service",
  "version": "0.1.0",
  "type": "module",
  "description": "Subscription Management System - AI Billing Assistant & MCP Service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:mock": "vitest run tests/realMcpExecution.test.ts tests/e2eChatPipeline.test.ts tests/providerFallback.test.ts",
    "diag:gemini": "tsx src/diagnostics/geminiDiagnostic.ts",
    "diag:hf": "tsx src/diagnostics/huggingFaceDiagnostic.ts",
    "diag:embedding": "tsx src/diagnostics/embeddingDiagnostic.ts",
    "diag:all": "tsx src/diagnostics/allDiagnostics.ts"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}


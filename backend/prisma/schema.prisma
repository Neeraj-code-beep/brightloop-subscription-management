// Prisma schema for Brightloop Subscription Management System
// Target Database: PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum ProductType {
  SOFTWARE
  SERVICE
  SUBSCRIPTION
  ADD_ON
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum CustomBillingUnit {
  DAYS
  WEEKS
  MONTHS
  YEARS
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  UNCOLLECTIBLE
  VOID
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum TaxType {
  VAT
  GST
  SALES_TAX
  CUSTOMS
  EXCISE
  OTHER
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  ACH
  MANUAL
  CASH
  UPI
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum CreditTransactionType {
  PRORATION_CREDIT
  MANUAL_ADJUSTMENT
  INVOICE_APPLICATION
  REFUND
}

enum MigrationType {
  UPGRADE
  DOWNGRADE
  SAME_PLAN_CYCLE_CHANGE
}

enum MigrationTiming {
  IMMEDIATE
  NEXT_CYCLE
}

enum MigrationStatus {
  COMPLETED
  SCHEDULED
  CANCELLED
}


// -------------------------------------------------------------
// CORE ENTITIES
// -------------------------------------------------------------

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String
  role                UserRole             @default(CUSTOMER)
  isActive            Boolean              @default(true)
  emailVerified       Boolean              @default(false)
  lastLoginAt         DateTime?
  createdById         String?
  createdBy           User?                @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers        User[]               @relation("UserCreatedBy")
  customer            Customer?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Customer {
  id                String         @id @default(cuid())
  userId            String?        @unique
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerCode      String         @unique
  customerType      CustomerType   @default(COMPANY)
  firstName         String?
  lastName          String?
  companyName       String?
  email             String         @unique
  phone             String?
  alternatePhone    String?
  billingAddress    String?
  billingCity       String?
  billingState      String?
  billingPostalCode String?
  billingCountry    String?
  taxNumber         String?
  notes             String?
  currency          String         @default("USD")
  isActive          Boolean        @default(true)
  status            CustomerStatus @default(ACTIVE)
  creditBalance     Decimal        @default(0.00) @db.Decimal(12, 2)
  quotations        Quotation[]
  subscriptions     Subscription[]
  invoices          Invoice[]
  payments          Payment[]
  discountRedemptions DiscountRedemption[]
  creditTransactions CreditTransaction[]
  migrations        SubscriptionMigration[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([email])
  @@index([customerCode])
  @@index([customerType])
  @@index([isActive])
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  type        ProductType      @default(SOFTWARE)
  basePrice   Decimal          @default(0.00) @db.Decimal(12, 2)
  costPrice   Decimal?         @db.Decimal(12, 2)
  isActive    Boolean          @default(true)
  variants    ProductVariant[]
  plans       Plan[]
  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([name])
  @@index([type])
  @@index([isActive])
  @@index([createdAt, id])
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String
  sku              String   @unique
  description      String?
  unit             String   @default("seat")
  unitPriceInCents Int      @default(0)
  additionalPrice  Decimal  @default(0.00) @db.Decimal(12, 2)
  isActive         Boolean  @default(true)
  plans            Plan[]
  planVariants     PlanVariant[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
  @@index([createdAt, id])
}

model Plan {
  id                 String             @id @default(cuid())
  productId          String
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String?
  variant            ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name               String
  description        String?
  billingCycle       BillingCycle       @default(MONTHLY)
  customDuration     Int?
  customDurationUnit CustomBillingUnit?
  price              Decimal            @default(0.00) @db.Decimal(12, 2)
  setupFee           Decimal            @default(0.00) @db.Decimal(12, 2)
  currency           String             @default("INR")
  trialDays          Int                @default(0)
  isActive           Boolean            @default(true)
  billingInterval    BillingInterval    @default(MONTHLY)
  intervalCount      Int                @default(1)
  priceInCents       Int                @default(0)
  planVariants       PlanVariant[]
  subscriptionItems  SubscriptionItem[]
  quotationItems     QuotationItem[]
  subscriptions      Subscription[]
  scheduledSubscriptions Subscription[] @relation("SubscriptionScheduledPlan")
  migrationsFrom     SubscriptionMigration[] @relation("MigrationFromPlan")
  migrationsTo       SubscriptionMigration[] @relation("MigrationToPlan")
  invoiceItems       InvoiceItem[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([productId])
  @@index([billingCycle])
  @@index([isActive])
  @@index([createdAt, id])
}

model PlanVariant {
  id        String         @id @default(cuid())
  planId    String
  plan      Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([planId, variantId])
  @@index([planId])
  @@index([variantId])
}

model Quotation {
  id                 String          @id @default(cuid())
  quotationNumber    String          @unique
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             QuotationStatus @default(DRAFT)
  currency           String          @default("INR")
  subtotal           Decimal         @default(0.00) @db.Decimal(12, 2)
  discountAmount     Decimal         @default(0.00) @db.Decimal(12, 2)
  taxAmount          Decimal         @default(0.00) @db.Decimal(12, 2)
  grandTotal         Decimal         @default(0.00) @db.Decimal(12, 2)
  subtotalInCents    Int             @default(0)
  taxInCents         Int             @default(0)
  discountInCents    Int             @default(0)
  totalInCents       Int             @default(0)
  validUntil         DateTime
  notes              String?
  termsAndConditions String?
  subscription       Subscription?
  items              QuotationItem[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt, id])
}

model QuotationItem {
  id               String    @id @default(cuid())
  quotationId      String
  quotation        Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  planId           String?
  plan             Plan?     @relation(fields: [planId], references: [id], onDelete: Restrict)
  description      String?
  quantity         Int       @default(1)
  unitPrice        Decimal   @default(0.00) @db.Decimal(12, 2)
  setupFee         Decimal   @default(0.00) @db.Decimal(12, 2)
  discountAmount   Decimal   @default(0.00) @db.Decimal(12, 2)
  taxAmount        Decimal   @default(0.00) @db.Decimal(12, 2)
  taxRate          Decimal   @default(0.00) @db.Decimal(5, 2)
  lineTotal        Decimal   @default(0.00) @db.Decimal(12, 2)
  selectedVariants Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([quotationId])
  @@index([productId])
  @@index([planId])
  @@index([createdAt, id])
}

model Subscription {
  id                 String             @id @default(cuid())
  subscriptionNumber String             @unique
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId             String?
  plan               Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  scheduledPlanId    String?
  scheduledPlan      Plan?              @relation("SubscriptionScheduledPlan", fields: [scheduledPlanId], references: [id], onDelete: SetNull)
  scheduledChangeAt  DateTime?
  quotationId        String?            @unique
  quotation          Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  status             SubscriptionStatus @default(ACTIVE)
  startDate          DateTime           @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime?
  endDate            DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  cancellationReason String?
  pausedAt           DateTime?
  resumedAt          DateTime?
  billingCycleAnchor DateTime           @default(now())
  billingCycle       BillingCycle       @default(MONTHLY)
  recurringPrice     Decimal            @default(0.00) @db.Decimal(12, 2)
  setupFee           Decimal            @default(0.00) @db.Decimal(12, 2)
  currency           String             @default("INR")
  discountId         String?
  discount           Discount?          @relation(fields: [discountId], references: [id], onDelete: SetNull)
  items              SubscriptionItem[]
  invoices           Invoice[]
  migrations         SubscriptionMigration[]
  creditTransactions CreditTransaction[]
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([customerId, status])
  @@index([currentPeriodEnd])
  @@index([planId])
  @@index([createdAt, id])
}

model SubscriptionItem {
  id               String       @id @default(cuid())
  subscriptionId   String
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  quantity         Int          @default(1)
  unitPriceInCents Int          @default(0)
  unitPrice        Decimal      @default(0.00) @db.Decimal(12, 2)
  lineTotal        Decimal      @default(0.00) @db.Decimal(12, 2)
  selectedVariants Json?
  invoiceItems     InvoiceItem[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([subscriptionId])
  @@index([planId])
  @@index([createdAt, id])
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status             InvoiceStatus @default(DRAFT)
  invoiceDate        DateTime      @default(now())
  dueDate            DateTime
  periodStart        DateTime?
  periodEnd          DateTime?
  currency           String        @default("INR")
  subtotal           Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal       @default(0.00) @db.Decimal(12, 2)
  amountPaid         Decimal       @default(0.00) @db.Decimal(12, 2)
  amountDue          Decimal       @default(0.00) @db.Decimal(12, 2)
  subtotalInCents    Int           @default(0)
  taxInCents         Int           @default(0)
  discountInCents    Int           @default(0)
  totalInCents       Int           @default(0)
  amountPaidInCents  Int           @default(0)
  amountDueInCents   Int           @default(0)
  notes              String?
  termsAndConditions String?
  paidAt             DateTime?
  issuedAt           DateTime?
  voidedAt           DateTime?
  pdfUrl             String?
  metadata           Json?
  items              InvoiceItem[]
  payments           Payment[]
  creditTransactions CreditTransaction[]
  migrations         SubscriptionMigration[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([customerId, status])
  @@index([dueDate])
  @@index([subscriptionId])
  @@index([createdAt, id])
}

model InvoiceItem {
  id                 String            @id @default(cuid())
  invoiceId          String
  invoice            Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  planId             String?
  plan               Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionItemId String?
  subscriptionItem   SubscriptionItem? @relation(fields: [subscriptionItemId], references: [id], onDelete: SetNull)
  description        String
  quantity           Int               @default(1)
  unitPrice          Decimal           @default(0.00) @db.Decimal(12, 2)
  discountAmount     Decimal           @default(0.00) @db.Decimal(12, 2)
  taxRate            Decimal           @default(0.00) @db.Decimal(5, 2)
  taxAmount          Decimal           @default(0.00) @db.Decimal(12, 2)
  lineSubtotal       Decimal           @default(0.00) @db.Decimal(12, 2)
  lineTotal          Decimal           @default(0.00) @db.Decimal(12, 2)
  unitPriceInCents   Int               @default(0)
  totalInCents       Int               @default(0)
  taxId              String?
  tax                Tax?              @relation(fields: [taxId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([invoiceId])
  @@index([productId])
  @@index([planId])
  @@index([subscriptionItemId])
  @@index([createdAt, id])
}

model Tax {
  id           String        @id @default(cuid())
  code         String?       @unique
  name         String
  rate         Decimal?      @db.Decimal(5, 2)
  percentage   Decimal       @db.Decimal(5, 2)
  type         TaxType       @default(SALES_TAX)
  jurisdiction String?
  description  String?
  validFrom    DateTime?
  validTo      DateTime?
  isCompound   Boolean       @default(false)
  priority     Int           @default(0)
  isActive     Boolean       @default(true)
  invoiceItems InvoiceItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([isActive])
  @@index([code])
  @@index([createdAt, id])
}

model Discount {
  id                        String                @id @default(cuid())
  code                      String                @unique
  name                      String?
  description               String?
  type                      DiscountType          @default(PERCENTAGE)
  value                     Decimal               @db.Decimal(12, 2)
  valueInBasisPoints        Int?
  currency                  String?               @default("INR")
  minPurchaseAmount         Decimal?              @db.Decimal(12, 2)
  maxDiscountAmount         Decimal?              @db.Decimal(12, 2)
  validFrom                 DateTime              @default(now())
  validTo                   DateTime?
  maxRedemptions            Int?
  maxRedemptionsPerCustomer Int?                  @default(1)
  timesRedeemed             Int                   @default(0)
  isActive                  Boolean               @default(true)
  subscriptions             Subscription[]
  redemptions               DiscountRedemption[]
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([createdAt, id])
}

model DiscountRedemption {
  id             String    @id @default(cuid())
  discountId     String
  discount       Discount  @relation(fields: [discountId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId      String?
  quotationId    String?
  subscriptionId String?
  amountApplied  Decimal   @db.Decimal(12, 2)
  redeemedAt     DateTime  @default(now())

  @@index([discountId, customerId])
  @@index([customerId])
}

model Payment {
  id                   String        @id @default(cuid())
  paymentReference     String        @unique
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId            String
  invoice              Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentMethod        PaymentMethod @default(MANUAL)
  provider             String        @default("MANUAL")
  providerTransactionId String?
  transactionReference String?
  amount               Decimal       @default(0.00) @db.Decimal(12, 2)
  amountInCents        Int           @default(0)
  currency             String        @default("INR")
  status               PaymentStatus @default(PENDING)
  paymentDate          DateTime      @default(now())
  failureReason        String?
  paidAt               DateTime?
  idempotencyKey       String?       @unique
  metadata             Json?
  refunds              Refund[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([customerId, status])
  @@index([invoiceId, status])
  @@index([paymentReference])
  @@index([providerTransactionId])
  @@index([createdAt, id])
}

model Refund {
  id               String       @id @default(cuid())
  refundReference  String       @unique
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount           Decimal      @default(0.00) @db.Decimal(12, 2)
  amountInCents    Int          @default(0)
  currency         String       @default("INR")
  reason           String?
  status           RefundStatus @default(SUCCEEDED)
  providerRefundId String?
  idempotencyKey   String?      @unique
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([paymentId])
  @@index([createdAt, id])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @unique
  eventType   String
  status      String   @default("PROCESSED")
  payload     Json?
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([provider, eventId])
  @@index([createdAt])
}



model CreditTransaction {
  id              String                @id @default(cuid())
  customerId      String
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscriptionId  String?
  subscription    Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoice         Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  migrationId     String?
  migration       SubscriptionMigration? @relation(fields: [migrationId], references: [id], onDelete: SetNull)
  type            CreditTransactionType
  amount          Decimal               @db.Decimal(12, 2)
  balanceAfter    Decimal               @db.Decimal(12, 2)
  currency        String                @default("INR")
  reason          String?
  idempotencyKey  String?               @unique
  metadata        Json?
  createdAt       DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@index([migrationId])
}

model SubscriptionMigration {
  id                     String             @id @default(cuid())
  subscriptionId         String
  subscription           Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  customerId             String
  customer               Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fromPlanId             String
  fromPlan               Plan               @relation("MigrationFromPlan", fields: [fromPlanId], references: [id], onDelete: Restrict)
  toPlanId               String
  toPlan                 Plan               @relation("MigrationToPlan", fields: [toPlanId], references: [id], onDelete: Restrict)
  migrationType          MigrationType
  timing                 MigrationTiming
  status                 MigrationStatus    @default(COMPLETED)
  effectiveDate          DateTime           @default(now())
  scheduledExecutionDate DateTime?
  fromBillingCycle       BillingCycle
  toBillingCycle         BillingCycle
  fromPrice              Decimal            @db.Decimal(12, 2)
  toPrice                Decimal            @db.Decimal(12, 2)
  unusedAmount           Decimal            @default(0.00) @db.Decimal(12, 2)
  newPlanAmount          Decimal            @default(0.00) @db.Decimal(12, 2)
  netAdjustment          Decimal            @default(0.00) @db.Decimal(12, 2)
  creditApplied          Decimal            @default(0.00) @db.Decimal(12, 2)
  invoiceIssuedId        String?
  invoiceIssued          Invoice?           @relation(fields: [invoiceIssuedId], references: [id], onDelete: SetNull)
  creditTransactions     CreditTransaction[]
  idempotencyKey         String?            @unique
  metadata               Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([subscriptionId, createdAt])
  @@index([customerId])
  @@index([status])
  @@index([effectiveDate])
}
